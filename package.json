{
  "name": "@jxsim/myuids",
  "version": "0.1.0",
  "type": "module",
  "description": "A classy React component library built with Tailwind v4 and Radix UI",
  "files": [
    "dist",
    "src/styles"
  ],
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./atoms": {
      "types": "./dist/components/atoms/index.d.ts",
      "import": "./dist/components/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/components/molecules/index.d.ts",
      "import": "./dist/components/molecules/index.js"
    },
    "./organisms": {
      "types": "./dist/components/organisms/index.d.ts",
      "import": "./dist/components/organisms/index.js"
    },
    "./templates": {
      "types": "./dist/components/templates/index.d.ts",
      "import": "./dist/components/templates/index.js"
    },
    "./styles": {
      "style": "./src/styles/tokens.css"
    },
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jxsim/myuids.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css",
    "src/styles/**"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:lib": "tsc --project tsconfig.lib.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublish": "pnpm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0",
    "@base-ui/react": ">=1.0.0",
    "radix-ui": ">=1.0.0",
    "@tabler/icons-react": ">=3.0.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.0.0",
    "tailwind-merge": ">=3.0.0",
    "tw-animate-css": ">=1.0.0",
    "cmdk": ">=1.0.0",
    "date-fns": ">=4.0.0",
    "embla-carousel-react": ">=8.0.0",
    "input-otp": ">=1.0.0",
    "next-themes": ">=0.4.0",
    "react-day-picker": ">=9.0.0",
    "react-resizable-panels": ">=4.0.0",
    "recharts": ">=2.0.0",
    "sonner": ">=2.0.0",
    "vaul": ">=1.0.0",
    "@fontsource-variable/inter": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "cmdk": { "optional": true },
    "date-fns": { "optional": true },
    "embla-carousel-react": { "optional": true },
    "input-otp": { "optional": true },
    "next-themes": { "optional": true },
    "react-day-picker": { "optional": true },
    "react-resizable-panels": { "optional": true },
    "recharts": { "optional": true },
    "sonner": { "optional": true },
    "vaul": { "optional": true },
    "@fontsource-variable/inter": { "optional": true }
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tabler/icons-react": "^3.40.0",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-resizable-panels": "^4.7.2",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/react-vite": "^10.2.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn": "^4.0.0",
    "storybook": "^10.2.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4"
  }
}
